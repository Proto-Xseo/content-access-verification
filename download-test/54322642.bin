<script>

const SIGN_SERVICE_URL = 'https://glb-apisign.cdn.cr/sign';

async function getSignedUrl(rawUrl) {
    const orig = new URL(rawUrl);
    const path = decodeURIComponent(orig.pathname);
    const r = await fetch(
        SIGN_SERVICE_URL + '?path=' + encodeURIComponent(path),
        { credentials: 'omit' }
    );
    if (!r.ok) throw new Error('sign ' + r.status);
    const { token, ex } = await r.json();
    orig.searchParams.set('token', token);
    orig.searchParams.set('ex', ex);
    return orig.toString();
}

document.addEventListener('DOMContentLoaded', () => {
    const downloadBtn = document.getElementById('download-btn');
    if (!downloadBtn) {
        console.error('Download button not found');
        return;
    }
    const id = downloadBtn.getAttribute('data-id');
    downloadBtn.addEventListener('click', (e) => {
        e.preventDefault();
        fetch('/api/_001_v2', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: id })
        })
        .then(response => {
            if (!response.ok) throw new Error('Metadata fetch failed');
            return response.json();
        })
        .then(meta => {
            const rawUrl = new URL(meta.mediafiles + meta.path);
            const originalName = meta.original || (typeof ogname !== 'undefined' ? ogname : '');
            if (originalName) rawUrl.searchParams.set('n', originalName);
            return getSignedUrl(rawUrl.toString());
        })
        .then(signedUrl => {
            window.location.href = signedUrl;
        })
        .catch(error => console.error('Download error:', error));
    });
});
</script>
